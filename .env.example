# Шаблон окружения стенда «Орбиты». Скопировать и заполнить:
#
#     cp .env.example .env
#
# Файл .env в репозиторий не попадает (.gitignore) — в нём ключи и пароли.
# Здесь ВСЕ переменные, которые читают compose и api: имя, пояснение и
# заглушка. Заглушка в угловых скобках <…> подлежит замене; оставленная как
# есть, она не «работает наполовину» — система отказывает и называет причину
# (ключ провайдера → отказ 401 в журнале вызовов, секрет входа → сессия не
# подтверждается). Пустое значение везде означает «не настроено»: система
# ведёт себя честно — сообщает состояние, а не притворяется работающей.

# ---------------------------------------------------------------- стенд
# Адрес и порт хоста, на котором открывается клиент. Локально — 8080; на
# сервере за Caddy — адрес docker0, чтобы наружу порт не торчал:
#     ORBITA_PORT=172.17.0.1:8030
ORBITA_PORT=8080

# Пароль базы. Значение orbita годится ТОЛЬКО для локального стенда; для
# сервера — случайный, например: openssl rand -hex 16
ORBITA_DB_PASSWORD=orbita

# Профили compose, которые поднимаются штатным `docker compose up`:
#   strictdoc — служба .sdoc/ReqIF (ADR-049/064), snapshot — снимок URL
#   (Playwright), capella — адаптер модели (только чтение), demo — сид.
# Несколько — через запятую: strictdoc,snapshot
COMPOSE_PROFILES=strictdoc

# ------------------------------------------------- служба ИИ (П5), прямой канал
# Ключ провайдера. Заглушку заменить на ключ; нет ключа — оставить ПУСТЫМ:
# тогда прямой канал недоступен, служба работает режимом закрытого контура
# (промпт отдаётся владельцу, ответ вносится файлом), а попытка прямого
# вызова оставляет в журнале запись с причиной отказа.
ORBITA_AI_KEY=<ключ провайдера>

# Адрес API провайдера. Пусто — https://api.anthropic.com (Messages API).
ORBITA_AI_URL=

# Модель по умолчанию, если профиль службы не задал свою (model_hint).
# Фактическая модель ответа всегда пишется в журнал вызова.
ORBITA_AI_MODEL=claude-sonnet-5

# Потолок ответа модели, токенов. У моделей с рассуждением бюджет делится
# между размышлением и текстом: при малом потолке весь он уходит в thinking,
# и ответ приходит пустым (журнал это показывает: tokens_out на потолке,
# предложено 0). Пусто — 8000; для пачек из 10+ объектов ставить 32000.
# Разбор материала просит свой потолок (64000) сам.
ORBITA_AI_MAX_TOKENS=32000

# Цены провайдера, долларов за миллион токенов. Оставленные пустыми — журнал
# честно показывает стоимость пустой, а мерой расхода служат ВЫЗОВЫ и ТОКЕНЫ:
# их провайдер сообщает сам, а цену — нет, и выдуманное число хуже пустого.
# Заполнять, только если нужен счёт в долларах: значения смотреть у провайдера
# на день прогона.
ORBITA_AI_PRICE_IN=
ORBITA_AI_PRICE_OUT=

# ------------------------------------------------------- вход (ADR-065, ADR-066)
# Режим входа. Пусто — учётки и роли из реестра (вход логином/паролем, пока
# учёток нет — открыто); stand — три витринные учётки без пароля
# (chernov · ivanov · petrova, только локальный стенд); telegram — вход через
# общий шлюз tg-authgw, стенд без сессии закрыт целиком.
ORBITA_AUTH_MODE=stand

# Шлюз tg-authgw и продукт в нём — только для режима telegram. Имена с
# префиксом ORBITA_ намеренно: у воркера оркестратора в окружении свои
# AUTHGW_URL/AUTHGW_PRODUCT, и без префикса они перебивали бы .env при
# подстановке compose. На 216 шлюз слушает docker0: http://172.17.0.1:8091
ORBITA_AUTHGW_URL=
ORBITA_AUTHGW_PRODUCT=orbita

# Секрет продукта orbita в AUTHGW_PRODUCTS шлюза — тот же, что там (HMAC
# сессии). Только для режима telegram.
ORBITA_SESSION_SECRET=<секрет продукта orbita в tg-authgw>

# Telegram id владельцев системы через запятую: руководитель во всех
# проектах, «выступить от имени роли» (ADR-066).
ORBITA_ADMIN_TIDS=<telegram id владельца>

# ----------------------------------------------------- обмен, снимки, модели
# Служба StrictDoc (.sdoc, ReqIF) — адрес внутри сети compose; пусто —
# канал обмена выключен, экспорт говорит об этом словами.
ORBITA_STRICTDOC_URL=http://strictdoc:8093

# Снимок URL службой рендера (профиль snapshot, Playwright). Пусто — только
# HTML без рендера: страница-каркас на JS честно отказывает.
ORBITA_SNAPSHOT_URL=

# Адаптер Capella (профиль capella, ADR-048: только чтение). Пусто — экран
# «Внешняя модель» показывает учебную fixture с баннером.
ORBITA_CAPELLA_URL=
ORBITA_CAPELLA_DIR=./ops/capella/model
ORBITA_CAPELLA_AIRD=model.aird

# ------------------------------------------------------- прочие настройки ядра
# Пути к нормативным каталогам и языковые таблицы переопределяются только при
# нестандартном размещении; на обычном стенде оставить как есть (пусто).
# ORBITA_ENUM_LABELS=
# ORBITA_FIELD_LABELS=
# ORBITA_UNIT_LABELS=
# ORBITA_GATES=
# ORBITA_PACKAGE_KINDS=
# ORBITA_QUALITY_RULES=
# ORBITA_KPI_AXES=
# ORBITA_PLATFORM_PRESETS=
# ORBITA_SCENARIO_LIBRARY=
# ORBITA_POPULATION_DATASET=
# ORBITA_IMPORT_SOURCES=
# ORBITA_PERF_CONFIG=
# ORBITA_PRINT_FONT=
# Тома стенда (внутри контейнера задаёт compose): ORBITA_FILES_DIR,
# ORBITA_BASELINES_DIR; адрес и порт api: ORBITA_HTTP_BIND, ORBITA_HTTP_PORT.
