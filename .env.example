# Шаблон окружения стенда «Орбиты». Скопировать и заполнить:
#
#     cp .env.example .env
#
# Файл .env в репозиторий не попадает (.gitignore) — в нём ключи и пароли.
# Здесь только имена переменных и пояснения: пустое значение везде означает
# «не настроено», и система обязана вести себя честно — сообщать состояние,
# а не притворяться работающей.

# ---------------------------------------------------------------- стенд
# Порт хоста, на котором открывается клиент.
ORBITA_PORT=8080

# Пароль базы. Значение по умолчанию (orbita) годится ТОЛЬКО для локального
# стенда; для сервера задаётся здесь — случайным, например:
#     openssl rand -hex 16
ORBITA_DB_PASSWORD=

# ------------------------------------------------- служба ИИ (П5), прямой канал
# Ключ провайдера. Пусто — прямой канал недоступен: служба работает режимом
# закрытого контура (промпт отдаётся владельцу, ответ вносится файлом), а
# попытка прямого вызова оставляет в журнале запись с причиной отказа.
ORBITA_AI_KEY=

# Адрес API провайдера. Пусто — https://api.anthropic.com (Messages API).
ORBITA_AI_URL=

# Модель по умолчанию, если профиль службы не задал свою (model_hint).
# Фактическая модель ответа всегда пишется в журнал вызова.
ORBITA_AI_MODEL=claude-sonnet-5

# Цены провайдера, долларов за миллион токенов. Оставленные пустыми — журнал
# честно показывает стоимость пустой, а мерой расхода служат ВЫЗОВЫ и ТОКЕНЫ:
# их провайдер сообщает сам, а цену — нет, и выдуманное число хуже пустого.
# Заполнять, только если нужен счёт в долларах: значения смотреть у провайдера
# на день прогона.
ORBITA_AI_PRICE_IN=
ORBITA_AI_PRICE_OUT=

# ------------------------------------------------------- прочие настройки ядра
# Пути к нормативным каталогам и языковые таблицы переопределяются только при
# нестандартном размещении; на обычном стенде оставить пустыми.
# ORBITA_ENUM_LABELS=
# ORBITA_FIELD_LABELS=
# ORBITA_GATES=
# ORBITA_PACKAGE_KINDS=
