{
  "name": "orbita-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Клиент ИС Орбита (ADR-010: TypeScript, React, CesiumJS). Расчётов в клиенте нет.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:screens": "node check-screens.mjs",
    "check:empty": "node check-empty-project.mjs"
  },
  "dependencies": {
    "cesium": "^1.144.0",
    "frappe-gantt": "^1.2.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "vite-plugin-cesium": "^1.2.23",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
