{
 "kind": "interface_template",
 "code": "IFT-9002",
 "version": 1,
 "title": "Типовые интерфейсы космической системы — класс НОО-IoT",
 "interface_types": {
  "RF": "радиолиния: диапазон, мощность, чувствительность, поляризация, протокол; требования: линк, ЭМС, регуляторика",
  "power": "электропитание: напряжение, ток, мощность, защита, пусковые токи; требования: качество питания, защита",
  "data": "данные/команды: протокол, скорость, объём, латентность, формат; требования: интерфейсные (ICD), ИБ",
  "thermal": "тепло: тепловыделение, проводимость, диапазоны на границе; требования: тепловые границы",
  "mech": "механика: крепление, нагрузки, вибрация, удар, юстировка; требования: прочность, отделение",
  "env": "среда: радиация, вакуум, атомарный кислород, тепловые циклы; требования: стойкость",
  "hmi": "человек-машина: операторы, роли, время реакции; требования: эргономика, автоматизация",
  "org": "организационный/регуляторный: частотные присвоения, соглашения, SLA; требования: соответствие, договорные"
 },
 "rules": [
  "интерфейс — ребро между двумя узлами PBS; интерфейсные требования распределяются на него, а не на узлы",
  "params интерфейса = анкета интерфейса; required_to — точка зрелости",
  "у каждого интерфейса — раздел ICD; ICD собирается из параметров и требований интерфейса (документ полки DT-ICD)",
  "внешний интерфейс (external) — требования к границе, чужая сторона не моделируется",
  "модели M2/M3 читают параметры интерфейса и обоих его концов",
  "данные полны; default_take=false — не в рекомендованном наборе класса по умолчанию, выбор — у инженера при взятии; зависимости между элементами вычисляются по ссылкам, не хранятся флагами"
 ],
