{
 "kind": "pbs_template",
 "code": "PBS-9002",
 "version": 2,
 "title": "Типовой PBS космической системы — класс НОО-IoT",
 "levels": [
  "система",
  "сегмент",
  "элемент",
  "подсистема",
  "агрегат",
  "блок"
 ],
 "rules": [
  "взятие создаёт уровни 0–3 всегда, 4–5 — по классу миссии (НОО-IoT: КА целиком)",
  "params узла = поля анкеты узла; required_to — точка зрелости (до неё — приглашение, после — разрыв)",
  "external=true — требования к интерфейсу, не к составу",
  "подгруппа построения = вхождение SC ×N",
  "данные полны; default_take=false — не в рекомендованном наборе класса по умолчанию, выбор — у инженера при взятии; зависимости между элементами вычисляются по ссылкам, не хранятся флагами"
 ],
 "units_to_add": [
  "площадь: м² (ввод см²)",
  "сила: Н (ввод мН)",
  "удельный импульс: с",
  "дБВт, дБи, дБ/К — логарифмические без конверсии",
  "Гц (частота собственная)",
  "л (объём, ввод мл)",
  "сут"
 ],
