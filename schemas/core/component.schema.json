{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/core/component.schema.json",
  "title": "Component",
  "description": "Узел одного дерева носителей — состава системы (ADR-044): система → сегмент → элемент → подсистема → компонент. Величины узла — parameters (имя = ключ анкеты Ф-06, единица справочника); структурные не-величины — profile.",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "lifecycle"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CM-[0-9]{4}$"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "segment",
        "element",
        "subsystem",
        "component",
        "system",
        "assembly"
      ],
      "description": "Уровень дерева (ADR-044): segment → element → subsystem → component. system и assembly — устаревшие значения, читаются в истории; новые узлы их не получают."
    },
    "segment": {
      "enum": [
        "space",
        "ground",
        "user"
      ],
      "description": "Обязателен для kind=segment"
    },
    "parent": {
      "type": "string",
      "pattern": "^CM-[0-9]{4}$"
    },
    "evolves_from": {
      "type": "string",
      "pattern": "^CM-[0-9]{4}$",
      "description": "Развитие определения: версия — часть идентичности, v2 помнит v1 (В2.1)"
    },
    "wbs_refs": {
      "type": "array",
      "description": "Связь состав ↔ WBS многие-ко-многим (В2.2): дерево работ — своя структура, не зеркало состава",
      "items": {
        "type": "string",
        "pattern": "^WB-[0-9]{4}$"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "quantity"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "$ref": "https://kis.local/schemas/common/quantity.schema.json"
          },
          "formula": {
            "type": "string",
            "description": "Выражение через параметры других компонентов (параметрическая модель)"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_tpm": {
            "type": "boolean",
            "default": false
          },
          "tpm": {
            "type": "object",
            "description": "Technical Performance Measure: цель, резерв, тренд к обзорам",
            "additionalProperties": false,
            "properties": {
              "target": {
                "$ref": "https://kis.local/schemas/common/quantity.schema.json"
              },
              "required_margin_pct": {
                "type": "number"
              },
              "trend": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "at",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "review": {
                      "enum": [
                        "SRR",
                        "SDR",
                        "MDR",
                        "PDR"
                      ]
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "peer"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "peer": {
            "type": "string",
            "pattern": "^CM-[0-9]{4}$"
          },
          "type": {
            "enum": [
              "rf",
              "data",
              "power",
              "mechanical",
              "thermal"
            ]
          },
          "responsibility": {
            "type": "string"
          }
        }
      }
    },
    "lifecycle": {
      "$ref": "https://kis.local/schemas/common/status.schema.json"
    },
    "provenance": {
      "$ref": "https://kis.local/schemas/common/provenance.schema.json",
      "description": "Происхождение объекта: ручной ввод, предложение ИИ или импорт (TZ-COM-005, шаг 15)"
    },
    "applies": {
      "type": "object",
      "description": "Применение библиотечного фрагмента (tailoring): экземпляр помнит прототип; отклонение и неприменимость требуют обоснования",
      "additionalProperties": false,
      "required": [
        "ref",
        "status"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^LF-[0-9]{4}$"
        },
        "status": {
          "enum": [
            "applied",
            "deviation",
            "not_applicable"
          ],
          "description": "применено · с отклонением · неприменимо"
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        }
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "deviation",
              "not_applicable"
            ]
          }
        }
      },
      "then": {
        "required": [
          "ref",
          "status",
          "rationale"
        ]
      }
    },
    "owner": {
      "type": "string",
      "description": "Владелец узла — логин учётки (В3): специалист работает в своих узлах; чужие для него закрыты на запись"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "description": "Структурные не-величины узла (ADR-044). Числа с единицами здесь запрещены — им место в parameters.",
      "properties": {
        "role": {
          "enum": [
            "spacecraft",
            "platform",
            "payload",
            "subsystem",
            "ground_station",
            "terminal"
          ],
          "description": "Роль узла для сборки контрактов: spacecraft — узел КА (вид «Модель аппарата»), platform/payload — анкеты Ф-06 PF-9001/PF-9002, subsystem — строка ведомости масс."
        },
        "subsystem": {
          "enum": [
            "structure",
            "power",
            "adcs",
            "propulsion",
            "obc",
            "comms",
            "thermal",
            "payload"
          ]
        },
        "maturity": {
          "enum": [
            "new",
            "modified",
            "existing"
          ]
        },
        "preset": {
          "type": "string",
          "description": "Пресет платформы (TZ-KA-001) у узла КА"
        },
        "mel_margin_policy": {
          "type": "object"
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sa_mounting": {
              "enum": [
                "body_fixed",
                "deployable_fixed",
                "steerable"
              ]
            }
          }
        },
        "attitude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "modes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "propulsion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {
              "type": "boolean"
            },
            "type": {
              "enum": [
                "cold_gas",
                "electric",
                "chemical"
              ]
            }
          }
        },
        "architecture": {
          "type": "string",
          "description": "Архитектура ПН (узел payload) — значение по контракту аппарата"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "https://kis.local/schemas/contracts/radio-link.schema.json"
          }
        },
        "onboard": {
          "type": "object",
          "description": "Бортовая политика ПН без buffer_mb: объём буфера — параметр buffer_size"
        },
        "ephemeris_beacon": {
          "type": "object"
        },
        "modes": {
          "type": "array",
          "description": "Режимы КА по контракту аппарата (узел spacecraft)",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "maneuvers": {
      "type": "array",
      "description": "Δv-бюджет узла КА таблицей манёвров (ответы владельца 03.09): строка — название, Δv величиной в м/с, примечание; свёртка — сумма в м/с. Названия по категориям контракта (phasing, maintenance, collision_avoidance, deorbit) ложатся в контракт аппарата, прочие — претензия сборки.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "delta_v"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "delta_v": {
            "$ref": "https://kis.local/schemas/common/quantity.schema.json"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
