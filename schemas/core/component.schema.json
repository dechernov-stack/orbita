{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/core/component.schema.json",
  "title": "Component",
  "description": "Узел дерева «Система — Компоненты» с параметрами и TPM (Ш4).",
  "type": "object",
  "required": ["id", "name", "kind", "lifecycle"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^CM-[0-9]{4}$" },
    "name": { "type": "string" },
    "kind": { "enum": ["segment", "system", "subsystem", "assembly"] },
    "segment": { "enum": ["space", "ground", "user"], "description": "Обязателен для kind=segment" },
    "parent": { "type": "string", "pattern": "^CM-[0-9]{4}$" },
    "wbs": { "type": "string" },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "quantity"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "quantity": { "$ref": "https://kis.local/schemas/common/quantity.schema.json" },
          "formula": { "type": "string", "description": "Выражение через параметры других компонентов (параметрическая модель)" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "is_tpm": { "type": "boolean", "default": false },
          "tpm": {
            "type": "object",
            "description": "Technical Performance Measure: цель, резерв, тренд к обзорам",
            "additionalProperties": false,
            "properties": {
              "target": { "$ref": "https://kis.local/schemas/common/quantity.schema.json" },
              "required_margin_pct": { "type": "number" },
              "trend": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["at", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "at": { "type": "string", "format": "date-time" },
                    "review": { "enum": ["SRR", "SDR", "MDR", "PDR"] },
                    "value": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "peer"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "peer": { "type": "string", "pattern": "^CM-[0-9]{4}$" },
          "type": { "enum": ["rf", "data", "power", "mechanical", "thermal"] },
          "responsibility": { "type": "string" }
        }
      }
    },
    "lifecycle": { "$ref": "https://kis.local/schemas/common/status.schema.json" },
    "provenance": {
      "$ref": "https://kis.local/schemas/common/provenance.schema.json",
      "description": "Происхождение объекта: ручной ввод, предложение ИИ или импорт (TZ-COM-005, шаг 15)"
    }
  }
}
