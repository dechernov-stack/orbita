{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/core/ground-stations.schema.json",
  "title": "GroundStationSet",
  "description": "Набор наземных станций приёма и управления. Хранимый объект: на него ссылается сценарий.",
  "type": "object",
  "required": [
    "id",
    "stations"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^GS-[0-9]{4}$"
    },
    "name": {
      "type": "string"
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "lat_deg",
          "lon_deg",
          "min_elevation_deg"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lat_deg": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon_deg": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "alt_m": {
            "type": "number"
          },
          "min_elevation_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 90
          },
          "g_over_t_db_k": {
            "type": "number"
          },
          "placement": {
            "enum": [
              "manual",
              "suggested"
            ],
            "default": "manual",
            "description": "suggested — предложено задачей моделирования (TZ-BAL, размещение)"
          }
        }
      }
    },
    "lifecycle": {
      "$ref": "https://kis.local/schemas/common/status.schema.json"
    },
    "provenance": {
      "$ref": "https://kis.local/schemas/common/provenance.schema.json",
      "description": "Происхождение объекта: ручной ввод, предложение ИИ или импорт (TZ-COM-005, шаг 15)"
    }
  }
}
