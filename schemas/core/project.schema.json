{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/core/project.schema.json",
  "title": "Project",
  "description": "Проект как объект (Шаг 17 C4): фаза жизненного цикла и перечень контрольных точек с плановыми датами. Реестр ворот остаётся источником планок статусов; проект говорит, какие точки и когда.",
  "type": "object",
  "required": ["id", "name", "phase", "milestones", "lifecycle"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^PJ-[0-9]{4}$"},
    "name": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "enum": ["pre_phase_a", "phase_a"]},
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate"],
        "additionalProperties": false,
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "due": {"type": "string", "description": "Плановая дата, ISO"},
          "held": {"type": "boolean", "description": "Точка пройдена"}
        }
      }
    },
    "lifecycle": {"$ref": "https://kis.local/schemas/common/status.schema.json"},
    "provenance": {"$ref": "https://kis.local/schemas/common/provenance.schema.json"}
  }
}
