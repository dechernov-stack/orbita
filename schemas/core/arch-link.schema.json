{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/core/arch-link.schema.json",
  "title": "ArchLink",
  "description": "Связь требования с внешним элементом модели (ADR-048): вид связи и обязательное обоснование — как trace-links.yaml workbench. Ложится в таблицу связей распределением, чтобы матрицы, impact и граф считали внешний элемент носителем наравне с узлами состава.",
  "type": "object",
  "required": ["id", "requirement", "element", "relation", "rationale", "lifecycle"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
    "requirement": {"type": "string", "pattern": "^RQ-[0-9]{4}$"},
    "element": {"type": "string", "pattern": "^ME-[0-9]{4}$"},
    "relation": {"enum": ["satisfied_by", "allocated_to", "realized_by", "traced_to"]},
    "rationale": {"type": "string", "minLength": 1, "description": "Почему связь такая — обязательно"},
    "author": {"type": "string"},
    "lifecycle": {"$ref": "https://kis.local/schemas/common/status.schema.json"},
    "provenance": {"$ref": "https://kis.local/schemas/common/provenance.schema.json"}
  }
}
