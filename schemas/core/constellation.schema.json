{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://kis.local/schemas/core/constellation.schema.json",
 "title": "Constellation",
 "description": "Конфигурация группировки. Хранимый объект: сценарий ссылается на него, версия входит в input_versions.",
 "type": "object",
 "required": [
  "id",
  "kind"
 ],
 "additionalProperties": false,
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^CN-[0-9]{4}$"
  },
  "name": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "walker_delta",
    "explicit",
    "composite"
   ],
   "description": "walker_delta/explicit — прежние одиночные формы (живут без правок); composite — составное построение из подгрупп"
  },
  "walker": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "inclination_deg",
    "total",
    "planes",
    "phasing",
    "altitude_km"
   ],
   "properties": {
    "inclination_deg": {
     "type": "number"
    },
    "total": {
     "type": "integer",
     "minimum": 1
    },
    "planes": {
     "type": "integer",
     "minimum": 1
    },
    "phasing": {
     "type": "integer",
     "minimum": 0
    },
    "altitude_km": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "sso": {
     "type": "boolean",
     "description": "ССО: наклонение вычисляется из высоты, введённое значение не используется"
    },
    "ltan_h": {
     "type": "number",
     "description": "Местное время восходящего узла опорной плоскости, ч; при нескольких плоскостях остальные разнесены по RAAN и их LTAN сдвинуты на 24/P ч. Обязателен для ССО (TZ-BAL-003)"
    }
   }
  },
  "orbits": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "inclination_deg",
     "altitude_km",
     "raan_deg",
     "mean_anomaly_deg"
    ],
    "properties": {
     "inclination_deg": {
      "type": "number"
     },
     "altitude_km": {
      "type": "number"
     },
     "raan_deg": {
      "type": "number"
     },
     "mean_anomaly_deg": {
      "type": "number"
     }
    }
   }
  },
  "lifecycle": {
   "$ref": "https://kis.local/schemas/common/status.schema.json"
  },
  "provenance": {
   "$ref": "https://kis.local/schemas/common/provenance.schema.json",
   "description": "Происхождение объекта: ручной ввод, предложение ИИ или импорт (TZ-COM-005, шаг 15)"
  },
  "subgroups": {
   "type": "array",
   "minItems": 1,
   "description": "Составное построение (МВП-М1): набор подгрупп; итог КА — сумма, вычисляется",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "kind",
     "planes",
     "per_plane",
     "altitude_km"
    ],
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "kind": {
      "enum": [
       "walker_delta",
       "walker_star",
       "sso"
      ],
      "description": "walker_delta — RAAN по кругу 360°/P; walker_star — веер 180°/P; sso — наклонение вычисляется из высоты, вводится LTAN"
     },
     "planes": {
      "type": "integer",
      "minimum": 1
     },
     "per_plane": {
      "type": "integer",
      "minimum": 1
     },
     "altitude_km": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "inclination_deg": {
      "type": "number",
      "description": "walker_*: наклонение; для sso игнорируется — вычисляется из высоты"
     },
     "phasing": {
      "type": "integer",
      "minimum": 0,
      "description": "фазовый параметр F (по умолчанию 0)"
     },
     "ltan_h": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 24,
      "description": "sso: местное время восходящего узла опорной плоскости, ч; остальные плоскости разнесены на 24/P ч"
     }
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "const": "composite"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "required": [
     "subgroups"
    ]
   }
  }
 ]
}