{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/core/decision.schema.json",
  "title": "Decision",
  "description": "Запись анализа альтернатив (Шаг 17 C3): вопрос, альтернативы, критерии, выбор с обоснованием. Решение decided без выбранной альтернативы или без обоснования не принимается: «решили, но не скажем что» хуже отсутствия записи.",
  "type": "object",
  "required": ["id", "question", "alternatives", "status", "lifecycle"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^DN-[0-9]{4}$"},
    "question": {"type": "string", "minLength": 1},
    "criteria": {"type": "array", "items": {"type": "string"}},
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "scenario_ref": {"type": "string", "pattern": "^SC-[0-9]{4}$"},
          "summary": {"type": "string"}
        }
      },
      "description": "Не менее двух: выбор из одного — не выбор"
    },
    "status": {"type": "string", "enum": ["open", "decided"]},
    "selected": {"type": "string", "description": "Имя выбранной альтернативы"},
    "rationale": {"type": "string"},
    "affects": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(RQ|CM|CN|SP)-[0-9]{4}$"},
      "description": "На какие объекты решение влияет"
    },
    "lifecycle": {"$ref": "https://kis.local/schemas/common/status.schema.json"},
    "provenance": {"$ref": "https://kis.local/schemas/common/provenance.schema.json"}
  }
}
