{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/core/need.schema.json",
  "title": "Need",
  "description": "Нужда стейкхолдера — вершина цифровой нити (Ш1).",
  "type": "object",
  "required": ["id", "statement", "stakeholder", "lifecycle"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ND-[0-9]{4}$" },
    "statement": { "type": "string", "minLength": 10 },
    "stakeholder": {
      "type": "object",
      "required": ["name", "role"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "role": { "enum": ["customer", "operator", "end_user", "regulator", "agency", "partner"] },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "traces_down": {
      "type": "array",
      "description": "ID сервисов, реализующих нужду (TZ-COM-002)",
      "items": { "type": "string", "pattern": "^SV-[0-9]{4}$" }
    },
    "lifecycle": { "$ref": "https://kis.local/schemas/common/status.schema.json" }
  }
}
