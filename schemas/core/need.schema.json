{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/core/need.schema.json",
  "title": "Need",
  "description": "Нужда стейкхолдера — вершина цифровой нити (Ш1).",
  "type": "object",
  "required": [
    "id",
    "statement",
    "stakeholder",
    "lifecycle"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ND-[0-9]{4}$"
    },
    "statement": {
      "type": "string",
      "minLength": 10
    },
    "stakeholder": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "customer",
            "operator",
            "end_user",
            "regulator",
            "agency",
            "partner"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "stakeholder_ref": {
      "type": "string",
      "pattern": "^SK-[0-9]{4}$",
      "description": "Ф-13: стейкхолдер-носитель нужды объектом проекта (Прил. 4: «источник — стейкхолдер или документ-основание»). Поле stakeholder остаётся именем и ролью для нужд, заведённых до появления объектов; ссылка — то, по чему нужды группируются и по чему придёт критерий согласования 7.1а."
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traces_down": {
      "type": "array",
      "description": "ID сервисов, реализующих нужду (TZ-COM-002)",
      "items": {
        "type": "string",
        "pattern": "^SV-[0-9]{4}$"
      }
    },
    "lifecycle": {
      "$ref": "https://kis.local/schemas/common/status.schema.json"
    },
    "provenance": {
      "$ref": "https://kis.local/schemas/common/provenance.schema.json",
      "description": "Происхождение объекта: ручной ввод, предложение ИИ или импорт (TZ-COM-005, шаг 15)"
    }
  }
}
