{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/core/requirement.schema.json",
  "title": "Requirement",
  "description": "Требование с атрибутами по Прил. 2 БП-PA. MOP порождается парой «сервис × вид потребителя» (Р9).",
  "type": "object",
  "required": ["id", "level", "statement", "category", "traces_up", "verification", "lifecycle", "owner"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^RQ-[0-9]{4}$" },
    "level": { "enum": ["project", "system", "element"] },
    "statement": { "type": "string", "minLength": 10, "description": "Форма «система должна…»" },
    "category": { "enum": ["functional", "performance", "interface", "operational", "reliability", "safety", "environmental", "constraint"] },
    "rationale": { "type": "string" },
    "traces_up": {
      "type": "array", "minItems": 1,
      "description": "Источник: нужда, сервис (пара с классом потребителя), родительское требование",
      "items": {
        "type": "object",
        "required": ["ref"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "pattern": "^(ND|SV|RQ)-[0-9]{4}$" },
          "consumer_class": { "enum": ["A_prime", "B_prime", "C_prime"], "description": "Обязателен при ссылке на сервис (Р9)" }
        }
      }
    },
    "allocated_to": {
      "type": "array",
      "description": "Элементы архитектуры (flow down, Ш4)",
      "items": { "type": "string", "pattern": "^CM-[0-9]{4}$" }
    },
    "mop": {
      "type": "object",
      "description": "Measure of Performance — измеримый показатель требования",
      "required": ["name", "target"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "target": { "$ref": "https://kis.local/schemas/common/quantity.schema.json" },
        "threshold": { "$ref": "https://kis.local/schemas/common/quantity.schema.json" },
        "tbd": { "type": "boolean", "default": false },
        "tbr": { "type": "boolean", "default": false }
      }
    },
    "verification": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["test", "analysis", "demonstration", "inspection"] },
        "phase": { "enum": ["PhaseA", "PhaseB", "PhaseC", "PhaseD"] },
        "evidence_ref": { "type": "string", "description": "ID результата моделирования или испытания" }
      }
    },
    "lifecycle": { "$ref": "https://kis.local/schemas/common/status.schema.json" },
    "owner": { "type": "string" }
  }
}
