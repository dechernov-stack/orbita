{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/core/requirement.schema.json",
  "title": "Requirement",
  "description": "Требование с атрибутами по Прил. 2 БП-PA. MOP порождается парой «сервис × вид потребителя» (Р9).",
  "type": "object",
  "required": [
    "id",
    "level",
    "statement",
    "category",
    "traces_up",
    "verification_events",
    "lifecycle",
    "owner"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RQ-[0-9]{4}$"
    },
    "level": {
      "enum": [
        "project",
        "system",
        "element"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 10,
      "description": "Форма «система должна…»"
    },
    "category": {
      "enum": [
        "functional",
        "performance",
        "interface",
        "operational",
        "reliability",
        "safety",
        "environmental",
        "constraint"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "traces_up": {
      "type": "array",
      "minItems": 1,
      "description": "Источник: нужда, сервис (пара с классом потребителя), родительское требование",
      "items": {
        "type": "object",
        "required": [
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(MG|ND|SV|RQ|NR)-[0-9]{4}$",
            "description": "Откуда следует требование: цель (MG), нужда (ND), сервис (SV) или родительское требование (RQ); NR — основание на норматив полки А1 (типовые требования библиотеки)"
          },
          "consumer_class": {
            "enum": [
              "A_prime",
              "B_prime",
              "C_prime"
            ],
            "description": "Обязателен при ссылке на сервис (Р9)"
          }
        }
      }
    },
    "allocated_to": {
      "type": "array",
      "description": "Куда распределено требование. Интерфейсное требование распределяется на интерфейс (две стороны), а не на один элемент.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "component"
            ]
          },
          {
            "required": [
              "interface"
            ]
          }
        ],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^CM-[0-9]{4}$",
            "description": "Элемент дерева изделия (CM-NNNN), на который распределено требование; выбирается из реестра «Элементы и интерфейсы»"
          },
          "interface": {
            "type": "string",
            "pattern": "^IF-[0-9]{4}$",
            "description": "Интерфейс (IF-NNNN) — стык с двумя сторонами; ИНТЕРФЕЙСНОЕ требование распределяется сюда, а не на элемент"
          },
          "kind": {
            "enum": [
              "full",
              "partial"
            ],
            "default": "full"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "mop": {
      "type": "object",
      "description": "Measure of Performance — измеримое условие требования. Оператор обязателен: «не более 500 г» и «не менее 500 г» — разные требования.",
      "required": [
        "name",
        "operator",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Что измеряется, напр. «Сухая масса»"
        },
        "operator": {
          "enum": [
            "eq",
            "le",
            "ge",
            "lt",
            "gt",
            "range",
            "tolerance"
          ],
          "description": "eq — ровно; le/ge — не более/не менее; lt/gt — строго; range — в пределах [value, upper]; tolerance — value ± tolerance"
        },
        "value": {
          "$ref": "https://kis.local/schemas/common/quantity.schema.json",
          "description": "Основное значение условия"
        },
        "upper": {
          "$ref": "https://kis.local/schemas/common/quantity.schema.json",
          "description": "Верхняя граница; обязательна при operator=range"
        },
        "tolerance": {
          "$ref": "https://kis.local/schemas/common/quantity.schema.json",
          "description": "Допуск; обязателен при operator=tolerance"
        },
        "threshold": {
          "$ref": "https://kis.local/schemas/common/quantity.schema.json",
          "description": "Минимально приемлемое значение (NASA threshold)"
        },
        "objective": {
          "$ref": "https://kis.local/schemas/common/quantity.schema.json",
          "description": "Желаемое значение (NASA objective)"
        },
        "rollup": {
          "enum": [
            "sum",
            "max",
            "min",
            "none"
          ],
          "default": "none",
          "description": "Правило свёртки по дочерним требованиям (derive): sum — бюджет массы/мощности; max — предельные величины; none — не сворачивается"
        },
        "tbd": {
          "type": "boolean",
          "default": false
        },
        "tbr": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "range"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "upper"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "const": "tolerance"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "tolerance"
            ]
          }
        }
      ]
    },
    "lifecycle": {
      "$ref": "https://kis.local/schemas/common/status.schema.json"
    },
    "owner": {
      "type": "string"
    },
    "derives_from": {
      "type": "array",
      "description": "Родительские требования, из которых данное получено декомпозицией (связь derive). Отличается от traces_up: traces_up — уточнение нужды или сервиса, derives_from — разбиение требования на составляющие.",
      "items": {
        "type": "string",
        "pattern": "^RQ-[0-9]{4}$"
      }
    },
    "verification_events": {
      "type": "array",
      "description": "События верификации. Требование обычно проверяется несколькими событиями на разных фазах и уровнях: предварительный расчёт по модели на ранней фазе, затем испытание изделия. Верификацию закрывает только событие с closes=true.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "method",
          "kind",
          "level",
          "status",
          "closes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VE-[0-9]{4}$"
          },
          "method": {
            "enum": [
              "test",
              "analysis",
              "demonstration",
              "inspection"
            ]
          },
          "kind": {
            "enum": [
              "preliminary",
              "qualification",
              "acceptance",
              "certification"
            ],
            "description": "preliminary — промежуточное подтверждение (расчёт, модель); qualification — подтверждение конструкции, проводится один раз на версию конструкции; acceptance — приёмка экземпляра; certification — формальное подтверждение"
          },
          "phase": {
            "enum": [
              "PhaseA",
              "PhaseB",
              "PhaseC",
              "PhaseD",
              "PhaseE"
            ]
          },
          "level": {
            "enum": [
              "component",
              "subsystem",
              "system",
              "end_to_end"
            ],
            "description": "Уровень структуры изделия, на котором выполняется проверка"
          },
          "approach": {
            "type": "string",
            "minLength": 20,
            "description": "Что именно делается: порядок действий, что измеряется. Не пересказ требования."
          },
          "means": {
            "type": "string",
            "description": "Стенд, методика, модель, документ. Обязательно для test и analysis."
          },
          "conditions": {
            "type": "string"
          },
          "success_criterion": {
            "type": "string"
          },
          "closes": {
            "type": "boolean",
            "default": false,
            "description": "Закрывает ли событие верификацию требования. Предварительное событие закрывать не может."
          },
          "design_version": {
            "type": "string",
            "description": "Для quali­fication: версия конструкции"
          },
          "unit": {
            "type": "string",
            "description": "Для acceptance: экземпляр изделия"
          },
          "status": {
            "enum": [
              "planned",
              "in_progress",
              "passed",
              "failed",
              "waived"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "pattern": "^EV-[0-9]{4}$"
          }
        }
      }
    },
    "provenance": {
      "$ref": "https://kis.local/schemas/common/provenance.schema.json",
      "description": "Происхождение объекта: ручной ввод, предложение ИИ или импорт (TZ-COM-005, шаг 15)"
    },
    "quality_waivers": {
      "type": "array",
      "description": "Осознанно отведённые правила качества формулировок (TZ-REQ-004): эвристика может ошибаться («в пределах» по смыслу ровно), и инженер вправе отвести замечание С ОБОСНОВАНИЕМ. Отвод действует на точный текст замечания; изменилось правило — изменился текст, вейвер гаснет, решение пересматривается. Неотводимы: TBD, полнота плана верификации, распределение интерфейсного требования",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 3,
            "description": "Точный текст отведённого замечания"
          },
          "rationale": {
            "type": "string",
            "minLength": 10,
            "description": "Почему правило здесь неприменимо"
          }
        }
      }
    },
    "applies": {
      "type": "object",
      "description": "Применение библиотечного фрагмента (tailoring): экземпляр помнит прототип; отклонение и неприменимость требуют обоснования",
      "additionalProperties": false,
      "required": [
        "ref",
        "status"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^LF-[0-9]{4}$"
        },
        "status": {
          "enum": [
            "applied",
            "deviation",
            "not_applicable"
          ],
          "description": "применено · с отклонением · неприменимо"
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        }
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "deviation",
              "not_applicable"
            ]
          }
        }
      },
      "then": {
        "required": [
          "ref",
          "status",
          "rationale"
        ]
      }
    }
  }
}
