{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/unit.schema.json",
  "title": "unit",
  "description": "единица измерения — вид 1 слоя L0. Сцена рождения: —. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dimension": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "canonical": {
      "type": "boolean"
    },
    "factor": {
      "type": "number",
      "description": "обязателен, если не канон"
    },
    "conversion_type": {
      "enum": [
        "linear",
        "offset",
        "log",
        "rate"
      ]
    },
    "offset": {
      "type": "number"
    },
    "rate_date": {
      "type": "string",
      "format": "date",
      "description": "для валют"
    },
    "display_default": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "dimension",
    "symbol",
    "name",
    "canonical",
    "conversion_type"
  ]
}
