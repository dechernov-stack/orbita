{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/project.schema.json",
  "title": "project",
  "description": "проект — вид 18 слоя L1. Сцена рождения: 1. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "manual",
            "package",
            "service",
            "shelf",
            "import",
            "example"
          ]
        },
        "author": {
          "type": "string",
          "description": "ссылка на вид: account"
        },
        "source": {
          "type": "string",
          "description": "ссылка на сущность"
        },
        "anchor": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "author"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string",
      "description": "правится в паспорте проекта (карточка), не только при создании"
    },
    "mission_class": {
      "type": "string",
      "description": "ссылка на вид: mission_class правится в паспорте проекта (карточка), не только при создании"
    },
    "manager": {
      "type": "string",
      "description": "ссылка на вид: account правится в паспорте проекта (карточка), не только при создании"
    },
    "phase_current": {
      "type": "string",
      "description": "ссылка на вид: phase"
    },
    "group": {
      "enum": [
        "work",
        "example"
      ]
    },
    "example": {
      "type": "boolean"
    },
    "knowledge_v2": {
      "type": "boolean",
      "description": "поле знаний v2 — синтез, сверка, ранг доверия; на прежних проектах выключено, новым ставится умолчанием стенда (ORBITA_KNOWLEDGE_V2_DEFAULT)"
    },
    "standard": {
      "enum": [
        "NASA-7120"
      ],
      "description": "имена в интерфейсе; кросс-термины — словарь"
    },
    "phase_template": {
      "type": "string",
      "description": "ссылка на вид: phase_template шаблон текущей фазы; меняется решением точки вместе с phase_current"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "name",
    "mission_class",
    "manager",
    "phase_current",
    "group",
    "example",
    "standard",
    "phase_template"
  ]
}
