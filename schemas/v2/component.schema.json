{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/component.schema.json",
  "title": "component",
  "description": "узел состава (определение) — вид 47 слоя L3. Сцена рождения: 7, A5. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "system",
        "segment",
        "element",
        "subsystem",
        "assembly",
        "unit"
      ]
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "parent": {
      "type": "string",
      "description": "ссылка на вид: component корень — без"
    },
    "level": {
      "description": "int 0–5"
    },
    "nature": {
      "enum": [
        "node",
        "behaviour"
      ],
      "description": "behaviour обязан быть развёрнут на node"
    },
    "external": {
      "type": "boolean"
    },
    "external_identity": {
      "type": "string",
      "description": "ссылка на вид: model_element"
    },
    "wbs_pair": {
      "type": "string",
      "description": "ссылка на вид: wbs_package"
    },
    "template_ref": {
      "type": "string",
      "description": "ссылка на вид: pbs_template.node | typical_component"
    },
    "applicability": {
      "enum": [
        "applied",
        "applied_with_deviation",
        "not_applicable"
      ]
    },
    "deviation_rationale": {
      "type": "string"
    },
    "structure_readonly": {
      "description": "bool (computed) true, если external_identity задан и модель есть"
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "ссылка на вид: normative_document"
      }
    },
    "maturity_tailoring": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target*:facet|param": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "action*:enum[add": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "remove": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "shift]": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "to_gate": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "rationale": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "by": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          }
        },
        "required": [
          "rationale",
          "by"
        ]
      },
      "description": "отклонение от лестницы шаблона; hard-грани не снимаются"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "code",
    "name",
    "level",
    "nature",
    "kind"
  ]
}
