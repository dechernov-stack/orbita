{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/fact.schema.json",
  "title": "fact",
  "description": "атомарный факт — вид 83 слоя L2. Сцена рождения: загрузка. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "enum": [
        "quantity",
        "capability",
        "obligation",
        "framing",
        "event",
        "relation",
        "assessment",
        "assumption",
        "external_target",
        "external_need"
      ]
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "manual",
            "package",
            "service",
            "shelf",
            "import",
            "example"
          ]
        },
        "author": {
          "type": "string",
          "description": "ссылка на вид: account"
        },
        "source": {
          "type": "string",
          "description": "ссылка на сущность"
        },
        "anchor": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "author"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entity_class": {
      "enum": [
        "requirement",
        "function",
        "service",
        "composition_node",
        "stakeholder",
        "constraint",
        "milestone",
        "normative_ref"
      ],
      "description": "класс сущности ТЗ (правило атомизации ШИП-G-ПРИНЯТ) — сверка разбора с пакетом по классам"
    },
    "subject": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "description": "ссылка на вид: entity"
        },
        "topic": {
          "type": "string",
          "description": "ссылка на вид: topic"
        }
      },
      "description": "ровно одно из двух"
    },
    "predicate": {
      "type": "string"
    },
    "quote": {
      "description": "str 10–200 дословный фрагмент источника, сверяется с каноном; у ручного факта эксперта — null"
    },
    "value": {
      "anyOf": [
        {
          "$ref": "https://kis.local/schemas/v2/_measure.schema.json"
        },
        {
          "type": "string"
        }
      ]
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "material": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            "anchor": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "account": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            "role": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            "at": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            }
          },
          "required": [
            "account",
            "role",
            "at"
          ]
        }
      ],
      "description": "документ с якорем — или эксперт без якоря (учётка · роль · дата); ровно одно из двух, стережёт Kotlin"
    },
    "mark": {
      "enum": [
        "И",
        "В",
        "П"
      ],
      "description": "ось «происхождение» (ОНТОЛОГИЯ-АУДИТ часть 3): И — внутреннее · В — внешнее · П — предположение; ставит источник/документ; прежнее имя source_mark снято"
    },
    "mark_no": {
      "type": "string",
      "description": "номер источника из списка документа: И1, В10 (прежнее имя source_mark_no)"
    },
    "evidence": {
      "enum": [
        "claimed",
        "corroborated",
        "measured",
        "assumed"
      ],
      "description": "ось «свидетельство» (ОНТОЛОГИЯ-АУДИТ часть 3): заявлено · подтверждено вторым источником · измерено · допущение; ставит система по сверке; уверенность (confidence) — ось ПРЕДЛОЖЕНИЯ, у факта её нет"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "disposition": {
      "enum": [
        "free",
        "noted",
        "assumed",
        "adopted",
        "rejected",
        "contested",
        "superseded"
      ]
    },
    "disposition_decision": {
      "type": "object",
      "properties": {
        "by": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "gate": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "by",
        "at",
        "reason"
      ],
      "description": "обязателен при любой диспозиции кроме free"
    },
    "assumption": {
      "type": "object",
      "properties": {
        "owner": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "confirm_by": {
          "type": "string",
          "description": "ссылка на вид: gate"
        },
        "validation": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "impact_if_wrong": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "owner",
        "confirm_by"
      ],
      "description": "обязателен при disposition=assumed; owner и confirm_by спрашивает окно приёма, validation и impact — по желанию"
    },
    "classification": {
      "enum": [
        "open",
        "dsp",
        "commercial"
      ],
      "description": "наследуется от источника"
    },
    "rank": {
      "enum": [
        "mandatory",
        "expert",
        "reference",
        "doubtful"
      ],
      "description": "ось «доверие» (ОНТОЛОГИЯ-АУДИТ часть 3) — наследуется от документа; expert — ручной ввод; ранг подсказывает в противоречии, не выбирает победителя; прежнее имя authority снято"
    },
    "parse_run": {
      "type": "string",
      "description": "ссылка на вид: parse_run обязателен с шипа 2 (изоляция вклада документа); у фактов, созданных до миграции, — null; обязательность обеспечивают ворота создания, не схема"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "subject",
    "predicate",
    "quote",
    "value",
    "source",
    "mark",
    "evidence",
    "as_of",
    "disposition",
    "classification",
    "rank"
  ]
}
