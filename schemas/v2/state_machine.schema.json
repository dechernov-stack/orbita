{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/state_machine.schema.json",
  "title": "state_machine",
  "description": "режимы и состояния компонента — вид 79 слоя L3. Сцена рождения: A5. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string",
      "description": "ссылка на вид: component"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "active_functions": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "ссылка на вид: function"
            }
          },
          "kind": {
            "enum": [
              "mode",
              "state"
            ]
          }
        },
        "required": [
          "code",
          "name",
          "active_functions",
          "kind"
        ]
      }
    },
    "initial": {
      "type": "string"
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "to": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "trigger": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "exchange",
                "event",
                "timer"
              ]
            },
            "description": "один из ключей: exchange · event · timer"
          },
          "guard": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "action": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "trigger"
        ]
      }
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "owner",
    "states",
    "initial",
    "transitions"
  ]
}
