{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/typical_requirement.schema.json",
  "title": "typical_requirement",
  "description": "типовое требование (библиотека) — вид 14 слоя L0. Сцена рождения: —. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "новая редакция подсвечивает экземпляры"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "ears_pattern": {
      "enum": [
        "ubiquitous",
        "event",
        "state",
        "unwanted",
        "optional"
      ]
    },
    "statement_template": {
      "type": "string",
      "description": "с плейсхолдерами {носитель}, {значение}"
    },
    "category": {
      "enum": [
        "functional",
        "performance",
        "interface",
        "operational",
        "constraint",
        "safety",
        "environment"
      ]
    },
    "measure": {
      "$ref": "https://kis.local/schemas/v2/_measure.schema.json"
    },
    "verification": {
      "type": "string",
      "description": "ссылка на вид: method_catalog"
    },
    "acceptance_criteria": {
      "type": "string"
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normative_basis": {
      "type": "object",
      "description": "{normative_document*,clause*}"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "title",
    "ears_pattern",
    "statement_template",
    "category",
    "verification",
    "applicability"
  ]
}
