{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/intake_task.schema.json",
  "title": "intake_task",
  "description": "задание загрузки — вид 82 слоя L2. Сцена рождения: любая. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "manual",
            "package",
            "service",
            "shelf",
            "import",
            "example"
          ]
        },
        "author": {
          "type": "string",
          "description": "ссылка на вид: account"
        },
        "source": {
          "type": "string",
          "description": "ссылка на сущность"
        },
        "anchor": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "author"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "description": "{file?|url?|text?}"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "path": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "hash": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "date",
        "hash"
      ],
      "description": "URL — рендер headless в PDF+MD"
    },
    "intent": {
      "type": "string",
      "description": "умолчание «разбери по сущностям»"
    },
    "intent_kind": {
      "enum": [
        "harvest",
        "shelve_typical",
        "baseline_candidate",
        "compare",
        "update_params",
        "register_normative",
        "assess_tor",
        "context_only",
        "other"
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "project": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "scene": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "mission_class": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "project",
        "scene",
        "mission_class"
      ]
    },
    "classification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content_type": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "share": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          }
        },
        "required": [
          "content_type",
          "blocks",
          "share"
        ]
      },
      "description": "Д2а"
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "ссылка на вид: action"
      }
    },
    "author": {
      "type": "string",
      "description": "ссылка на вид: account"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "source",
    "snapshot",
    "intent",
    "intent_kind",
    "context",
    "plan",
    "author"
  ]
}
