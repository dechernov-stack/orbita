{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/process_catalog.schema.json",
  "title": "process_catalog",
  "description": "каталог процессов СИ (двухстандартный) — вид 88 слоя L0. Сцена рождения: —. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "npr_7123": {
      "type": "string",
      "description": "один из 17 процессов"
    },
    "romanov_activity": {
      "type": "string",
      "description": "код мероприятия ROM-… из ПОЛКА-ПРОЦЕССЫ-РОМАНОВ"
    },
    "iso_15288": {
      "type": "string",
      "description": "процесс ГОСТ ISO 15288-2023"
    },
    "group": {
      "enum": [
        "system_design",
        "product_realization",
        "technical_management",
        "agreement",
        "organizational",
        "mbse"
      ]
    },
    "orbita_mechanism": {
      "type": "string"
    },
    "place": {
      "type": "string",
      "description": "маршрут интерфейса"
    },
    "tailoring_allowed": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "code",
    "name",
    "group",
    "orbita_mechanism",
    "place",
    "tailoring_allowed"
  ]
}
