{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/stakeholder.schema.json",
  "title": "stakeholder",
  "description": "стейкхолдер / актор — вид 33 слоя L2. Сцена рождения: 3. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "manual",
            "package",
            "service",
            "shelf",
            "import",
            "example"
          ]
        },
        "author": {
          "type": "string",
          "description": "ссылка на вид: account"
        },
        "source": {
          "type": "string",
          "description": "ссылка на сущность"
        },
        "anchor": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "author"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "role": {
      "enum": [
        "customer",
        "regulator",
        "operator",
        "consumer",
        "supplier",
        "partner",
        "established"
      ]
    },
    "interest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "quote": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "fact": {
            "type": "string",
            "description": "ссылка на вид: fact"
          }
        },
        "required": [
          "statement"
        ]
      },
      "description": "интересы стороны её словами, каждый с цитатой (ОНТОЛОГИЯ-АУДИТ часть 4) — не роль, не нужда; нужда из интереса — решением (предложение через сверку, не автомат); строка прежних записей сходит первым интересом"
    },
    "scale": {
      "$ref": "https://kis.local/schemas/v2/_measure.schema.json"
    },
    "establishes": {
      "type": "boolean"
    },
    "influence": {
      "type": "string",
      "description": "enum[decides,influences,informed] (computed from role) карта ОНТОЛОГИЯ-ФОРМИРОВАНИЯ.influence_map; значение модели снимается; инженер правит на месте"
    },
    "power": {
      "description": "int 1–5 оценка человека 1–5; пусто до сцены 3"
    },
    "attitude": {
      "enum": [
        "supports",
        "neutral",
        "resists"
      ],
      "description": "поддерживает · нейтрален · сопротивляется"
    },
    "liaison": {
      "type": "string",
      "description": "ссылка на вид: account ответственный за взаимодействие (учётка)"
    },
    "normatives": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "ссылка на вид: normative_document"
      },
      "description": "для регуляторов — какие акты несёт"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "name",
    "role",
    "interest"
  ]
}
