{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/debris_assessment.schema.json",
  "title": "debris_assessment",
  "description": "оценка засорения (ODA) — вид 55 слоя L3. Сцена рождения: 11, A9. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variant": {
      "type": "string",
      "description": "ссылка на вид: constellation_variant"
    },
    "lifetime_years": {
      "type": "number"
    },
    "deorbit_dv": {
      "$ref": "https://kis.local/schemas/v2/_measure.schema.json"
    },
    "normative": {
      "type": "string",
      "description": "ссылка на вид: normative_document"
    },
    "compliant": {
      "type": "boolean"
    },
    "model_run": {
      "type": "string",
      "description": "ссылка на вид: model_run"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "variant",
    "lifetime_years",
    "deorbit_dv",
    "normative",
    "compliant",
    "model_run"
  ]
}
