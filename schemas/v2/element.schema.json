{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/element.schema.json",
  "title": "element",
  "description": "элемент содержания раздела — вид 86 слоя L5. Сцена рождения: по разделу. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "enum": [
        "fact_ref",
        "entity_ref",
        "statement",
        "query",
        "figure",
        "table"
      ]
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "section": {
      "type": "string",
      "description": "ссылка на вид: section"
    },
    "ref": {
      "type": "string",
      "description": "ссылка на вид: fact | ref entity | ref model_run обязателен для fact_ref/entity_ref/figure"
    },
    "ref_version": {
      "type": "integer",
      "description": "версия опоры на момент включения"
    },
    "text": {
      "type": "string",
      "description": "только для statement, 1–3 предложения"
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "ссылка на вид: fact|entity"
      },
      "description": "обязателен для statement с числами"
    },
    "query": {
      "type": "object",
      "description": "{kind*,filter*,columns?} для query/table"
    },
    "author": {
      "type": "string",
      "description": "ссылка на вид: account"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "order": {
      "type": "integer"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "section",
    "kind",
    "author",
    "at",
    "order"
  ]
}
