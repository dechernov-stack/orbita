{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/need.schema.json",
  "title": "need",
  "description": "нужда — вид 34 слоя L2. Сцена рождения: 3. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "manual",
            "package",
            "service",
            "shelf",
            "import",
            "example"
          ]
        },
        "author": {
          "type": "string",
          "description": "ссылка на вид: account"
        },
        "source": {
          "type": "string",
          "description": "ссылка на сущность"
        },
        "anchor": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "author"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "statement": {
      "type": "string"
    },
    "stakeholder": {
      "type": "string",
      "description": "ссылка на вид: stakeholder owns"
    },
    "qos_class": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "description": "ссылка на вид: qos_class (≥1)"
          }
        },
        {
          "type": "object",
          "properties": {
            "owner": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            "gate": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            }
          },
          "description": "форма «tbr»",
          "required": [
            "owner",
            "gate"
          ]
        }
      ],
      "description": "один или несколько классов из текста; сервис уточняет один; TBR допустим до сцены 6"
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "material": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "anchor": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          }
        },
        "required": [
          "material",
          "anchor"
        ]
      }
    },
    "coverage_expected": {
      "enum": [
        "service",
        "constraint",
        "programme",
        "requirement"
      ],
      "description": "чем закрывается нужда; умолчание из роли носителя (заказчик/оператор/потребитель/учреждаемый → service; регулятор → constraint; поставщик/партнёр → programme); правит инженер"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "statement",
    "stakeholder",
    "qos_class",
    "coverage_expected"
  ]
}
