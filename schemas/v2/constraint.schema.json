{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/constraint.schema.json",
  "title": "constraint",
  "description": "ограничение Р — вид 36 слоя L2. Сцена рождения: 5. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "description": "str Р-N"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "manual",
            "package",
            "service",
            "shelf",
            "import",
            "example"
          ]
        },
        "author": {
          "type": "string",
          "description": "ссылка на вид: account"
        },
        "source": {
          "type": "string",
          "description": "ссылка на сущность"
        },
        "anchor": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "author"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "enum": [
        "technical",
        "programmatic",
        "launch",
        "regulatory",
        "financial"
      ]
    },
    "statement": {
      "type": "string"
    },
    "cancelled": {
      "type": "object",
      "properties": {
        "by": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "by",
        "at",
        "reason"
      ]
    },
    "bound": {
      "type": "object",
      "properties": {
        "key": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "op": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "op",
        "value",
        "unit"
      ],
      "description": "Числовая граница рамки, если ограничение её задаёт: `key` — что меряем (mass, power, data), `op` — оператор (le, ge, lt, gt), `value` и `unit` — сама граница. Без этого поля ограничение остаётся текстом и НИЧЕГО не сторожит: свёртка не может сказать «106 кг > Р2», потому что не знает, что Р2 — про массу и про 100."
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "type",
    "statement"
  ]
}
