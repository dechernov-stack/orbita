{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/cost_estimate.schema.json",
  "title": "cost_estimate",
  "description": "оценка стоимости / сроков — вид 62 слоя L4. Сцена рождения: 12, A10. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string",
      "description": "ссылка на вид: wbs_package|project"
    },
    "range": {
      "type": "object",
      "description": "{min*,max*,unit*=млн ₽}"
    },
    "assumptions": {
      "type": "string"
    },
    "method": {
      "enum": [
        "rom",
        "parametric",
        "bottom_up"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "cadre": {
      "type": "boolean"
    },
    "includes_maturation": {
      "description": "bool (computed) все технологии с разрывом TRL имеют пакет в оценке"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "scope",
    "range",
    "assumptions",
    "method",
    "date"
  ]
}
