{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/milestone.schema.json",
  "title": "milestone",
  "description": "программный этап / внешняя веха (из документов и плана) — вид 286 слоя L1. Сцена рождения: 2, 12, 14. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "enum": [
        "program_stage",
        "external_event",
        "contract"
      ],
      "description": "вехи технологий — gate.kind=technology, не здесь"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "range": {
      "type": "object",
      "description": "{start*,end*,unit*} этап записки: 0–1,5 года"
    },
    "fleet": {
      "$ref": "https://kis.local/schemas/v2/_measure.schema.json"
    },
    "source": {
      "type": "string",
      "description": "ссылка на вид: fact derived_from_fact"
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "ссылка на вид: gate | plan"
      },
      "description": "что от неё зависит: даты точек, FA §4"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "name",
    "source"
  ]
}
