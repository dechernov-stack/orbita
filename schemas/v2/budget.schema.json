{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/budget.schema.json",
  "title": "budget",
  "description": "бюджет / свёртка — вид 59 слоя L4. Сцена рождения: 7, A5. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "enum": [
        "mass",
        "power",
        "energy",
        "link",
        "dv",
        "data",
        "compute"
      ]
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "manual",
            "package",
            "service",
            "shelf",
            "import",
            "example"
          ]
        },
        "author": {
          "type": "string",
          "description": "ссылка на вид: account"
        },
        "source": {
          "type": "string",
          "description": "ссылка на сущность"
        },
        "anchor": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "author"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root": {
      "type": "string",
      "description": "ссылка на вид: component"
    },
    "reserve_policy": {
      "type": "string",
      "description": "словами — как держится резерв по ступеням (для документа); число для ворот — в reserve_pct"
    },
    "reserve_pct": {
      "description": "num 0–100 резерв в процентах от потолка к текущей ступени; потолок долей = значение требования-потолка × (1 − reserve_pct/100); нет числа — без резерва, помета «резерв не задан числом» (диф владельца 29.09)"
    },
    "requirement": {
      "type": "string",
      "description": "ссылка на вид: requirement требование-потолок: значение бюджета — его measure (не дублируется здесь); доли — требования со связью derives на него; сумма принятых и принимаемых долей ≤ потолка, отказ — при приёме, при предложении — помета (диф владельца 29.09)"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "root",
    "reserve_policy"
  ]
}
