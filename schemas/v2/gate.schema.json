{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/gate.schema.json",
  "title": "gate",
  "description": "точка / ворота — вид 22 слоя L1. Сцена рождения: 1. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "enum": [
        "phase",
        "technology"
      ],
      "description": "веха технологии «TRL n достигнут»"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "manual",
            "package",
            "service",
            "shelf",
            "import",
            "example"
          ]
        },
        "author": {
          "type": "string",
          "description": "ссылка на вид: account"
        },
        "source": {
          "type": "string",
          "description": "ссылка на сущность"
        },
        "anchor": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "author"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phase": {
      "type": "string",
      "description": "ссылка на вид: phase"
    },
    "key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "planned_date": {
      "type": "string",
      "format": "date"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "ссылка на вид: criterion"
      }
    },
    "decision": {
      "type": "string",
      "description": "ссылка на вид: decision"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "standard": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          }
        },
        "required": [
          "standard",
          "name"
        ]
      }
    },
    "expertise": {
      "type": "object",
      "properties": {
        "goal": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "validation_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "main_outcome": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "control_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "object",
                  "array",
                  "null"
                ]
              },
              "maturity": {
                "enum": [
                  "С",
                  "Р",
                  "F",
                  "U",
                  "Σ",
                  "Δ",
                  "x",
                  "°"
                ]
              },
              "our_ref": {
                "type": "string",
                "description": "ссылка на вид: document_template|kind"
              }
            },
            "required": [
              "artifact",
              "maturity"
            ]
          }
        }
      },
      "required": [
        "goal",
        "validation_questions",
        "results",
        "main_outcome",
        "control_items"
      ],
      "description": "из ПОЛКА-ПРОЦЕССЫ-РОМАНОВ.expertises_full; коды зрелости — легенда владельца"
    },
    "expertise_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "answer": {
            "enum": [
              "yes",
              "no"
            ]
          },
          "by": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "at": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "finding": {
            "type": "string",
            "description": "ссылка на вид: finding"
          }
        },
        "required": [
          "question",
          "answer",
          "by",
          "at"
        ]
      },
      "description": "ответы чек-листа экспертизы, включая «да»: кто и когда; «нет» рождает замечание"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "phase",
    "key",
    "title",
    "planned_date",
    "criteria"
  ]
}
