{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/export.schema.json",
  "title": "export",
  "description": "выгрузка — вид 71 слоя L5. Сцена рождения: по запросу. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "enum": [
        "reqif",
        "sdoc",
        "knowledge",
        "gate_package"
      ]
    },
    "scope": {
      "type": "string",
      "description": "ссылка на вид: project|gate"
    },
    "fingerprint": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "hash": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "hash"
        ]
      }
    },
    "by": {
      "type": "string",
      "description": "ссылка на вид: account"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "reqif_profile": {
      "enum": [
        "ORBITA"
      ],
      "description": "атрибуты ReqIF.ForeignID/Name/Text/ChapterName + ORBITA.Level/Category/Priority/MOP.*/Verification/Acceptance/Rationale/Source/Status/Version/Baseline/Carrier/Template/Applicability"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "type",
    "scope",
    "fingerprint",
    "files",
    "by",
    "at"
  ]
}
