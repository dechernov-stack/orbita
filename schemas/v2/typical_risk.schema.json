{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/typical_risk.schema.json",
  "title": "typical_risk",
  "description": "типовой риск (библиотека) — вид 141 слоя L0. Сцена рождения: —. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "statement": {
      "type": "string"
    },
    "cec": {
      "type": "object",
      "description": "{condition*,event*,consequence*}"
    },
    "category": {
      "enum": [
        "technical",
        "cost",
        "schedule",
        "safety",
        "regulatory",
        "security",
        "programmatic"
      ]
    },
    "probability": {
      "description": "int 1–5"
    },
    "impact": {
      "description": "int 1–5"
    },
    "strategy": {
      "enum": [
        "mitigate",
        "accept",
        "transfer",
        "avoid"
      ]
    },
    "measures": {
      "type": "string"
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "statement",
    "cec",
    "category",
    "probability",
    "impact",
    "strategy",
    "measures",
    "applicability"
  ]
}
