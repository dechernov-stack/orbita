{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/typical_risk.schema.json",
  "title": "typical_risk",
  "description": "типовые записи — вид 14 слоя L0. Сцена рождения: —. В истине схем описан группой «typical_requirement · typical_risk · stakeholder_profile» — поля общие на группу. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "typical_requirement": {
      "type": "object",
      "description": "{code*,title*,statement*,category*,measure?,verification*,acceptance?,applicability*:class[],normative_basis?}"
    },
    "typical_risk": {
      "type": "object",
      "description": "{code*,statement*,cec*,probability*,impact*,strategy*,applicability*}"
    },
    "stakeholder_profile": {
      "type": "object",
      "description": "{code*,role*,name*,interests*,typical_needs?}"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "typical_requirement",
    "typical_risk",
    "stakeholder_profile"
  ]
}
