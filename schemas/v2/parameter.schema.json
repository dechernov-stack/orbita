{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/parameter.schema.json",
  "title": "parameter",
  "description": "значение параметра узла — вид 74 слоя L3. Сцена рождения: 7, A5+. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target": {
      "type": "string",
      "description": "ссылка на вид: component|interface"
    },
    "key": {
      "type": "string",
      "description": "ключ анкеты"
    },
    "measure": {
      "$ref": "https://kis.local/schemas/v2/_measure.schema.json"
    },
    "origin": {
      "enum": [
        "manual",
        "datasheet",
        "shelf",
        "computed",
        "example"
      ]
    },
    "source": {
      "type": "object",
      "description": "{material?,anchor?,model_run?} обязателен для datasheet и computed"
    },
    "required_to": {
      "type": "string",
      "description": "ссылка на вид: gate"
    },
    "basis": {
      "type": "string",
      "description": "обязателен при правке после baseline"
    },
    "maturity_class": {
      "enum": [
        "estimated",
        "modified",
        "off_the_shelf",
        "measured"
      ],
      "description": "резерв по классу"
    },
    "uncertainty": {
      "description": "num ±% по ступени, если не задано"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "target",
    "key",
    "measure",
    "origin",
    "required_to",
    "maturity_class",
    "uncertainty"
  ]
}
