{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/data_type.schema.json",
  "title": "data_type",
  "description": "тип данных — вид 78 слоя L0/L3. Сцена рождения: A5. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "base": {
      "enum": [
        "int",
        "float",
        "bool",
        "enum",
        "string",
        "bytes",
        "struct"
      ]
    },
    "unit": {
      "type": "string",
      "description": "ссылка на вид: unit обязателен для числовых величин"
    },
    "range": {
      "type": "object",
      "description": "{min?,max?}"
    },
    "enum_values": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "data_type": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "data_type"
        ]
      },
      "description": "для struct"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "code",
    "name",
    "base"
  ]
}
