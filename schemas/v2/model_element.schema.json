{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/model_element.schema.json",
  "title": "model_element",
  "description": "внешний элемент модели — вид 50 слоя L3. Сцена рождения: A5. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool": {
      "enum": [
        "capella"
      ]
    },
    "model_id": {
      "type": "string"
    },
    "uuid": {
      "type": "string",
      "description": "истина идентичности"
    },
    "type": {
      "enum": [
        "OperationalCapability",
        "SystemFunction",
        "LogicalFunction",
        "LogicalComponent",
        "PhysicalComponent",
        "FunctionalExchange",
        "FunctionalChain",
        "Diagram"
      ]
    },
    "layer": {
      "enum": [
        "OA",
        "SA",
        "LA",
        "PA"
      ]
    },
    "name_snapshot": {
      "type": "string"
    },
    "refreshed_at": {
      "type": "string",
      "format": "date-time"
    },
    "fixture": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "tool",
    "model_id",
    "uuid",
    "type",
    "layer",
    "name_snapshot",
    "refreshed_at",
    "fixture"
  ]
}
