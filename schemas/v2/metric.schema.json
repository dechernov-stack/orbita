{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/metric.schema.json",
  "title": "metric",
  "description": "метрика сравнения — вид 58 слоя L4. Сцена рождения: 7. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "manual",
            "package",
            "service",
            "shelf",
            "import",
            "example"
          ]
        },
        "author": {
          "type": "string",
          "description": "ссылка на вид: account"
        },
        "source": {
          "type": "string",
          "description": "ссылка на сущность"
        },
        "anchor": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "author"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variant": {
      "type": "string",
      "description": "ссылка на вид: constellation_variant"
    },
    "measure": {
      "$ref": "https://kis.local/schemas/v2/_measure.schema.json"
    },
    "threshold": {
      "type": "object",
      "properties": {
        "op": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "op",
        "value"
      ],
      "description": "порог отсева: {op,value,unit}; отсеянный вариант называет порог по имени"
    },
    "group": {
      "enum": [
        "A",
        "B",
        "V",
        "G"
      ],
      "description": "группа сравнения: покрытие · задержка · стоимость · риск (четыре группы AoA)"
    },
    "proxy": {
      "type": "boolean"
    },
    "direction": {
      "enum": [
        "max",
        "min"
      ],
      "description": "куда лучше: больше или меньше"
    },
    "model_run": {
      "type": "string",
      "description": "ссылка на вид: model_run откуда значение; пусто — ручное/прокси с пометой"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "variant",
    "measure",
    "group",
    "direction"
  ]
}
