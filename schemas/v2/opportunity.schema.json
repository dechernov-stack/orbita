{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/opportunity.schema.json",
  "title": "opportunity",
  "description": "возможность применения системы к чужой нужде или цели — вид 288 слоя L2. Сцена рождения: загрузка контекстного документа, сцены 3–7. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string",
      "description": "человеческий, переименуемый"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "description": "{channel*:enum[manual,package,service,shelf,import,example], author*:ref account, source?:ref, anchor?:str, fingerprint?:str}"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_item": {
      "type": "string",
      "description": "ссылка на вид: fact чужая нужда/цель с якорем"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string",
          "description": "ссылка на вид: stakeholder"
        },
        {
          "type": "string"
        }
      ],
      "description": "чья"
    },
    "our_services": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "description": "ссылка на вид: service"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "description": "ссылка на вид: component"
          }
        }
      ]
    },
    "verdict": {
      "enum": [
        "covered",
        "partial",
        "not_our_profile",
        "needs_work"
      ]
    },
    "missing": {
      "type": "string",
      "description": "чего не хватает"
    },
    "scale": {
      "$ref": "https://kis.local/schemas/v2/_measure.schema.json"
    },
    "proposal": {
      "enum": [
        "extend_scope",
        "add_service",
        "descope",
        "reject"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "confidence": {
      "description": "num 0–1"
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "external_item",
    "owner",
    "verdict",
    "rationale",
    "confidence"
  ]
}
