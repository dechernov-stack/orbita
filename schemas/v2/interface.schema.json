{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/v2/interface.schema.json",
  "title": "interface",
  "description": "стык — вид 49 слоя L3. Сцена рождения: 7, A5. СГЕНЕРИРОВАНО tools/v2/gen_schemas.py из docs/tz/v2/СХЕМЫ-ПОЛЕЙ-V2.yaml — руками не править",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "стабильный внутренний"
    },
    "code": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "description": "ссылка на вид: kind"
    },
    "area": {
      "enum": [
        "library",
        "project:id"
      ]
    },
    "born_in": {
      "type": "string",
      "description": "ссылка на вид: scene проектная область; библиотека — null"
    },
    "status": {
      "type": "string",
      "description": "enum по статусной модели вида"
    },
    "version": {
      "type": "integer",
      "description": "битемпорально"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "manual",
            "package",
            "service",
            "shelf",
            "import",
            "example"
          ]
        },
        "author": {
          "type": "string",
          "description": "ссылка на вид: account"
        },
        "source": {
          "type": "string",
          "description": "ссылка на сущность"
        },
        "anchor": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "channel",
        "author"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "не печатается"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "type": {
      "enum": [
        "RF",
        "power",
        "data",
        "thermal",
        "mech",
        "env",
        "hmi",
        "org"
      ]
    },
    "a": {
      "type": "string",
      "description": "ссылка на вид: component"
    },
    "b": {
      "anyOf": [
        {
          "type": "string",
          "description": "ссылка на вид: component"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "number",
                "boolean",
                "object",
                "array",
                "null"
              ]
            },
            "owner": {
              "type": "string",
              "description": "ссылка на вид: stakeholder"
            }
          },
          "description": "форма «external»",
          "required": [
            "name"
          ]
        }
      ],
      "description": "сторона b — узел состава или внешняя система (ГАИС «ЭРА-ГЛОНАСС», ОСМ); ICD печатает внешнюю сторону именем"
    },
    "direction": {
      "enum": [
        "uni",
        "bi",
        "static",
        "org"
      ]
    },
    "standard": {
      "type": "string"
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "measure": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "required_to": {
            "type": [
              "string",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "measure",
          "required_to"
        ]
      }
    },
    "icd_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "code",
    "kind",
    "area",
    "born_in",
    "status",
    "version",
    "provenance",
    "created_at",
    "updated_at",
    "name",
    "type",
    "a",
    "b",
    "direction",
    "requirement_classes"
  ]
}
