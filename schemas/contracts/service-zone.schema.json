{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis.local/schemas/contracts/service-zone.schema.json",
  "title": "ServiceZone",
  "description": "Зона обслуживания по линии — контракт «КА → баллистика». Зона обслуживания ≠ зона видимости: footprint сужается замыканием бюджета линии и наличием ёмкости.",
  "type": "object",
  "required": ["spacecraft_ref", "link_ref", "terminal_profile_ref", "altitude_km", "min_elevation_deg", "boundary"],
  "additionalProperties": false,
  "properties": {
    "spacecraft_ref": { "type": "string" },
    "link_ref": { "type": "string" },
    "terminal_profile_ref": { "type": "string", "description": "Зона зависит от терминала: для A' шире, для C' уже" },
    "altitude_km": { "type": "number", "exclusiveMinimum": 0 },
    "min_elevation_deg": {
      "type": "number", "minimum": 0, "maximum": 90,
      "description": "Геометрический предел видимости"
    },
    "boundary": {
      "type": "object",
      "required": ["service_elevation_deg", "limiting_factor"],
      "additionalProperties": false,
      "properties": {
        "service_elevation_deg": {
          "type": "number", "minimum": 0, "maximum": 90,
          "description": "Угол места, при котором запас линии равен требуемому. Всегда ≥ min_elevation_deg"
        },
        "limiting_factor": {
          "enum": ["link_margin", "antenna_pattern", "capacity", "doppler"],
          "description": "Что ограничивает зону: сужение footprint должно иметь причину"
        },
        "radius_km": { "type": "number", "exclusiveMinimum": 0 },
        "area_km2": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "link_budget": {
      "type": "object",
      "description": "Бюджет на краю зоны (худшая геометрия). Раздельно по участкам — следствие regenerative (Р1)",
      "additionalProperties": false,
      "properties": {
        "eirp_dbw": { "type": "number" },
        "fspl_db": { "type": "number" },
        "atmospheric_loss_db": { "type": "number" },
        "polarization_loss_db": { "type": "number" },
        "pointing_loss_db": { "type": "number" },
        "c_over_n0_dbhz": { "type": "number" },
        "required_ebn0_db": { "type": "number" },
        "margin_db": { "type": "number" }
      }
    },
    "doppler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_shift_hz": { "type": "number" },
        "max_rate_hz_s": { "type": "number" },
        "within_receiver_capture": { "type": "boolean" }
      }
    }
  }
}
